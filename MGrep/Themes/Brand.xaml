<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  MILLIMAN BRAND PRIMITIVES                                           ║
    ║                                                                      ║
    ║  ⚠  PLACEHOLDER VALUES — Replace with the official Milliman brand   ║
    ║     palette before any production or customer-facing release.        ║
    ║     Request the hex values from the Milliman Design / Brand team.    ║
    ║                                                                      ║
    ║  ❌  DO NOT REFERENCE THESE KEYS FROM CONTROL STYLES OR TEMPLATES.  ║
    ║     Only Light.xaml and Dark.xaml may reference MillimanXxx keys.   ║
    ║     Control styles must use semantic tokens (BrushXxx) exclusively.  ║
    ║                                                                      ║
    ║  HOW TO UPDATE FOR A BRAND REFRESH:                                  ║
    ║     1. Replace the hex values below with approved brand values.      ║
    ║     2. Re-validate WCAG AA contrast ratios (4.5:1 body, 3:1 UI).    ║
    ║     3. Build and verify — no other file needs to change.             ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ── Blue ramp — primary brand colour family ─────────────────────
         ⚠ PLACEHOLDER: Replace with official Milliman blue palette.
    ──────────────────────────────────────────────────────────────────── -->
    <Color x:Key="MillimanBlue050">#E8F0FB</Color>
    <Color x:Key="MillimanBlue100">#C7D9F5</Color>
    <Color x:Key="MillimanBlue200">#9CBCE8</Color>
    <Color x:Key="MillimanBlue300">#6E9DDA</Color>
    <Color x:Key="MillimanBlue400">#4680CE</Color>
    <Color x:Key="MillimanBlue500">#1E63C2</Color>  <!-- Primary brand blue -->
    <Color x:Key="MillimanBlue600">#1A54A6</Color>
    <Color x:Key="MillimanBlue700">#14428A</Color>
    <Color x:Key="MillimanBlue800">#0E306E</Color>
    <Color x:Key="MillimanBlue900">#081E52</Color>

    <!-- ── Neutral ramp — backgrounds, surfaces, borders, text ────────
         ⚠ PLACEHOLDER: Replace with official Milliman neutral palette.
    ──────────────────────────────────────────────────────────────────── -->
    <Color x:Key="MillimanNeutral000">#FFFFFF</Color>
    <Color x:Key="MillimanNeutral050">#F9F9F9</Color>
    <Color x:Key="MillimanNeutral100">#F3F3F3</Color>
    <Color x:Key="MillimanNeutral150">#EBEBEB</Color>
    <Color x:Key="MillimanNeutral200">#E1E1E1</Color>
    <Color x:Key="MillimanNeutral300">#C8C8C8</Color>
    <Color x:Key="MillimanNeutral400">#A0A0A0</Color>
    <Color x:Key="MillimanNeutral500">#737373</Color>
    <Color x:Key="MillimanNeutral600">#5C5C5C</Color>
    <Color x:Key="MillimanNeutral700">#404040</Color>
    <Color x:Key="MillimanNeutral750">#323232</Color>
    <Color x:Key="MillimanNeutral800">#272727</Color>
    <Color x:Key="MillimanNeutral850">#202020</Color>
    <Color x:Key="MillimanNeutral900">#1A1A1A</Color>
    <Color x:Key="MillimanNeutral950">#121212</Color>

    <!-- ── Status colours ─────────────────────────────────────────────
         Light-mode values. See *Dark variants for dark-mode usage.
         ⚠ PLACEHOLDER: Confirm with brand/accessibility team.
    ──────────────────────────────────────────────────────────────────── -->
    <Color x:Key="MillimanErrorRed">#C42B1C</Color>
    <Color x:Key="MillimanWarningAmber">#9D5D00</Color>
    <Color x:Key="MillimanSuccessGreen">#0F7B0F</Color>
    <Color x:Key="MillimanInfoBlue">#0078D4</Color>

    <!-- Dark-mode adjusted status colours (lighter for dark backgrounds) -->
    <Color x:Key="MillimanErrorRedDark">#FF99A4</Color>
    <Color x:Key="MillimanWarningAmberDark">#FCE100</Color>
    <Color x:Key="MillimanSuccessGreenDark">#6CCB5F</Color>
    <Color x:Key="MillimanInfoBlueDark">#60CDFF</Color>

</ResourceDictionary>
