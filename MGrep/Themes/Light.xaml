<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  LIGHT THEME — SEMANTIC TOKENS                                       ║
    ║                                                                      ║
    ║  Maps Milliman brand primitives (Brand.xaml) to UI semantic roles.  ║
    ║  Also overrides WPF-UI brush keys so WPF-UI control templates       ║
    ║  automatically render with Milliman brand colours.                   ║
    ║                                                                      ║
    ║  RULES:                                                              ║
    ║    ✅  Only MillimanXxx keys may be referenced here.                 ║
    ║    ✅  Controls reference BrushXxx keys via DynamicResource.         ║
    ║    ❌  No literal hex values.                                         ║
    ║    ❌  No DynamicResource needed here — Brand.xaml never changes.    ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ── Application backgrounds ────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBackground"          Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="BrushSurface"             Color="{StaticResource MillimanWhite}" />
    <SolidColorBrush x:Key="BrushSurfaceSecondary"    Color="{StaticResource MillimanLightestGray}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated"     Color="{StaticResource MillimanWhite}" />

    <!-- ── Foregrounds / text ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushForegroundPrimary"   Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="BrushForegroundSecondary" Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="BrushForegroundDisabled"  Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="BrushForegroundOnAccent"  Color="{StaticResource MillimanWhite}" />

    <!-- ── Accent (primary interactive colour) ─────────────────────── -->
    <!-- Hover = Obsidian: matches milliman.com primary button hover behaviour -->
    <SolidColorBrush x:Key="BrushAccent"              Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="BrushAccentHover"         Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="BrushAccentPressed"       Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="BrushAccentDisabled"      Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="BrushAccentSubtle"        Color="{StaticResource MillimanHighlightBlue}" />
    <SolidColorBrush x:Key="BrushAccentText"          Color="{StaticResource MillimanOcean}" />

    <!-- ── Borders & focus ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBorder"              Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="BrushBorderStrong"        Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="BrushBorderFocus"         Color="{StaticResource MillimanOcean}" />

    <!-- ── Status ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushError"               Color="{StaticResource MillimanError}" />
    <SolidColorBrush x:Key="BrushWarning"             Color="{StaticResource MillimanWarning}" />
    <SolidColorBrush x:Key="BrushSuccess"             Color="{StaticResource MillimanSuccess}" />
    <SolidColorBrush x:Key="BrushInfo"                Color="{StaticResource MillimanOcean}" />

    <!-- ── Shell chrome ────────────────────────────────────────────── -->
    <!-- StatusBar uses a subtle grey close to the window background in light mode -->
    <SolidColorBrush x:Key="BrushStatusBar"           Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="BrushStatusBarText"       Color="{StaticResource MillimanObsidian}" />

    
    <!-- ── Caption buttons (title bar chrome) ─────────────────────── -->
    <!-- Hover background for min/max/theme-toggle (neutral grey)       -->
    <SolidColorBrush x:Key="BrushCaptionButtonHover"  Color="{StaticResource MillimanLighterGray}" />
    <!-- Close button hover — red per Windows convention                 -->
    <SolidColorBrush x:Key="BrushCaptionCloseHover"   Color="{StaticResource MillimanError}" />

    <!--
    ════════════════════════════════════════════════════════════════════════
    WPF-UI BRUSH KEY OVERRIDES
    Override WPF-UI internal tokens so WPF-UI control templates
    automatically pick up Milliman brand colours.
    Loaded after ThemesDictionary, so these values win.
    ════════════════════════════════════════════════════════════════════════
    -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"          Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"        Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"         Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"         Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush"          Color="{StaticResource MillimanWhite}" />

    <!-- Accent text -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"    Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush"  Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"   Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"   Color="{StaticResource MillimanDarkenGray}" />

    <!-- Text on accent background -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="{StaticResource MillimanWhite}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource MillimanLightestGray}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource MillimanWhite}" />

    <!-- Accent fills (buttons, toggles, progress bars) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"        Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"      Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"       Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"       Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource MillimanOcean}" />

    <!-- Control fills (inputs, non-accent interactive surfaces) -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"       Color="{StaticResource MillimanWhite}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"     Color="{StaticResource MillimanLightestGray}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"      Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="ControlFillColorQuarternaryBrush"   Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"      Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush"   Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"   Color="{StaticResource MillimanWhite}" />

    <!-- Control strokes (borders) -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"     Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"   Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush"   Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush"  Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush"  Color="{StaticResource MillimanLighterGray}" />

    <!-- Subtle fills (list item hover, row highlights) -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush"    Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"      Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"       Color="{StaticResource MillimanLighterGray}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush"       Color="Transparent" />

    <!-- Layer fills (cards, panels) -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"         Color="{StaticResource MillimanWhite}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush"             Color="{StaticResource MillimanLightestGray}" />

    <!-- Application / window background -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"         Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"  Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush"      Color="{StaticResource MillimanLightestGray}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"    Color="{StaticResource MillimanLightestGray}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"     Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush"  Color="{StaticResource MillimanLighterGray}" />

    <!-- Card backgrounds -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="{StaticResource MillimanWhite}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource MillimanLightestGray}" />

    <!-- Focus -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"         Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush"         Color="{StaticResource MillimanWhite}" />

    <!-- System status fills -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"        Color="{StaticResource MillimanSuccess}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"        Color="{StaticResource MillimanWarning}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"       Color="{StaticResource MillimanError}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush"        Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush"   Color="{StaticResource MillimanDarkenGray}" />
    <!-- ── Match highlight (search span background) ─────────────────── -->
    <SolidColorBrush x:Key="BrushMatchHighlightBackground" Color="{StaticResource MillimanHighlightBlue}" />
    <SolidColorBrush x:Key="BrushMatchHighlightForeground" Color="{StaticResource MillimanOcean}" />

</ResourceDictionary>
