<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  LIGHT THEME — SEMANTIC TOKENS                                       ║
    ║                                                                      ║
    ║  Maps Milliman brand primitives (Brand.xaml) to UI semantic roles.  ║
    ║  Also overrides WPF-UI brush keys so WPF-UI control templates       ║
    ║  automatically pick up Milliman brand colours.                       ║
    ║                                                                      ║
    ║  RULES:                                                              ║
    ║    ✅  Only MillimanXxx keys may be referenced here.                 ║
    ║    ✅  Controls reference BrushXxx keys via DynamicResource.         ║
    ║    ❌  No literal hex values.                                         ║
    ║    ❌  No DynamicResource needed here — Brand.xaml never changes.    ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ── Application backgrounds ────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBackground"          Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="BrushSurface"             Color="{StaticResource MillimanNeutral000}" />
    <SolidColorBrush x:Key="BrushSurfaceSecondary"    Color="{StaticResource MillimanNeutral050}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated"     Color="{StaticResource MillimanNeutral000}" />

    <!-- ── Foregrounds / text ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushForegroundPrimary"   Color="{StaticResource MillimanNeutral900}" />
    <SolidColorBrush x:Key="BrushForegroundSecondary" Color="{StaticResource MillimanNeutral600}" />
    <SolidColorBrush x:Key="BrushForegroundDisabled"  Color="{StaticResource MillimanNeutral400}" />
    <SolidColorBrush x:Key="BrushForegroundOnAccent"  Color="{StaticResource MillimanNeutral000}" />

    <!-- ── Accent (primary interactive colour) ─────────────────────── -->
    <SolidColorBrush x:Key="BrushAccent"              Color="{StaticResource MillimanBlue500}" />
    <SolidColorBrush x:Key="BrushAccentHover"         Color="{StaticResource MillimanBlue600}" />
    <SolidColorBrush x:Key="BrushAccentPressed"       Color="{StaticResource MillimanBlue700}" />
    <SolidColorBrush x:Key="BrushAccentDisabled"      Color="{StaticResource MillimanNeutral300}" />
    <SolidColorBrush x:Key="BrushAccentSubtle"        Color="{StaticResource MillimanBlue050}" />
    <SolidColorBrush x:Key="BrushAccentText"          Color="{StaticResource MillimanBlue600}" />

    <!-- ── Borders & focus ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBorder"              Color="{StaticResource MillimanNeutral300}" />
    <SolidColorBrush x:Key="BrushBorderStrong"        Color="{StaticResource MillimanNeutral400}" />
    <SolidColorBrush x:Key="BrushBorderFocus"         Color="{StaticResource MillimanBlue500}" />

    <!-- ── Status ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushError"               Color="{StaticResource MillimanErrorRed}" />
    <SolidColorBrush x:Key="BrushWarning"             Color="{StaticResource MillimanWarningAmber}" />
    <SolidColorBrush x:Key="BrushSuccess"             Color="{StaticResource MillimanSuccessGreen}" />
    <SolidColorBrush x:Key="BrushInfo"                Color="{StaticResource MillimanInfoBlue}" />

    <!-- ── Shell chrome ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushStatusBar"           Color="{StaticResource MillimanBlue700}" />
    <SolidColorBrush x:Key="BrushStatusBarText"       Color="{StaticResource MillimanNeutral000}" />

    <!--
    ════════════════════════════════════════════════════════════════════════
    WPF-UI BRUSH KEY OVERRIDES
    Override WPF-UI's internal tokens so that WPF-UI control templates
    automatically render with Milliman brand colours.
    These override the ThemesDictionary which is loaded first.
    ════════════════════════════════════════════════════════════════════════
    -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"          Color="{StaticResource MillimanNeutral900}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"        Color="{StaticResource MillimanNeutral600}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"         Color="{StaticResource MillimanNeutral500}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"         Color="{StaticResource MillimanNeutral400}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush"          Color="{StaticResource MillimanNeutral000}" />

    <!-- Accent text -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"    Color="{StaticResource MillimanBlue600}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush"  Color="{StaticResource MillimanBlue700}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"   Color="{StaticResource MillimanBlue500}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"   Color="{StaticResource MillimanNeutral400}" />

    <!-- Text on accent background -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="{StaticResource MillimanNeutral000}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource MillimanNeutral050}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource MillimanNeutral300}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource MillimanNeutral000}" />

    <!-- Accent fills (buttons, toggles, progress bars) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"        Color="{StaticResource MillimanBlue500}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"      Color="{StaticResource MillimanBlue600}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"       Color="{StaticResource MillimanBlue400}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"       Color="{StaticResource MillimanNeutral300}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource MillimanBlue500}" />

    <!-- Control fills (inputs, non-accent interactive surfaces) -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"       Color="{StaticResource MillimanNeutral000}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"     Color="{StaticResource MillimanNeutral050}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"      Color="{StaticResource MillimanNeutral150}" />
    <SolidColorBrush x:Key="ControlFillColorQuarternaryBrush"   Color="{StaticResource MillimanNeutral200}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"      Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush"   Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"   Color="{StaticResource MillimanNeutral000}" />

    <!-- Control strokes (borders) -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"     Color="{StaticResource MillimanNeutral300}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"   Color="{StaticResource MillimanNeutral400}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush"   Color="{StaticResource MillimanBlue700}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{StaticResource MillimanBlue800}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush"  Color="{StaticResource MillimanBlue400}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush"  Color="{StaticResource MillimanNeutral300}" />

    <!-- Subtle fills (list item hover, row highlights) -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush"    Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"      Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"       Color="{StaticResource MillimanNeutral150}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush"       Color="Transparent" />

    <!-- Layer fills (cards, panels) -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"         Color="{StaticResource MillimanNeutral000}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush"             Color="{StaticResource MillimanNeutral050}" />

    <!-- Application / window background -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"         Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"  Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush"      Color="{StaticResource MillimanNeutral050}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"    Color="{StaticResource MillimanNeutral050}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"     Color="{StaticResource MillimanNeutral100}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush"  Color="{StaticResource MillimanNeutral150}" />

    <!-- Card backgrounds -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="{StaticResource MillimanNeutral000}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource MillimanNeutral050}" />

    <!-- Focus -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"         Color="{StaticResource MillimanBlue500}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush"         Color="{StaticResource MillimanNeutral000}" />

    <!-- System status fills -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"        Color="{StaticResource MillimanSuccessGreen}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"        Color="{StaticResource MillimanWarningAmber}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"       Color="{StaticResource MillimanErrorRed}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush"        Color="{StaticResource MillimanNeutral600}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush"   Color="{StaticResource MillimanNeutral400}" />

</ResourceDictionary>
