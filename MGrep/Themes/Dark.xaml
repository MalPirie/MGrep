<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  DARK THEME — SEMANTIC TOKENS                                        ║
    ║                                                                      ║
    ║  Maps Milliman brand primitives (Brand.xaml) to UI semantic roles.  ║
    ║  Also overrides WPF-UI brush keys so WPF-UI control templates       ║
    ║  automatically render with Milliman brand colours on dark surfaces.  ║
    ║                                                                      ║
    ║  RULES:                                                              ║
    ║    ✅  Only MillimanXxx keys may be referenced here.                 ║
    ║    ✅  Controls reference BrushXxx keys via DynamicResource.         ║
    ║    ❌  No literal hex values.                                         ║
    ║    ❌  No DynamicResource needed here — Brand.xaml never changes.    ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!-- ── Application backgrounds ────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBackground"          Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="BrushSurface"             Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="BrushSurfaceSecondary"    Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated"     Color="{StaticResource MillimanObsidianLight}" />

    <!-- ── Foregrounds / text ──────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushForegroundPrimary"   Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="BrushForegroundSecondary" Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="BrushForegroundDisabled"  Color="{StaticResource MillimanSlate}" />
    <!-- Text on Sky/Ocean accent background — Obsidian gives 7.3:1 on Sky ✅ -->
    <SolidColorBrush x:Key="BrushForegroundOnAccent"  Color="{StaticResource MillimanObsidian}" />

    <!-- ── Accent (primary interactive colour) ─────────────────────── -->
    <!-- Sky is Milliman's interactive colour for dark contexts (used on bg-obsidian) -->
    <SolidColorBrush x:Key="BrushAccent"              Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="BrushAccentHover"         Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="BrushAccentPressed"       Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="BrushAccentDisabled"      Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="BrushAccentSubtle"        Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="BrushAccentText"          Color="{StaticResource MillimanSky}" />

    <!-- ── Borders & focus ─────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushBorder"              Color="{StaticResource MillimanObsidianBorder}" />
    <SolidColorBrush x:Key="BrushBorderStrong"        Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="BrushBorderFocus"         Color="{StaticResource MillimanSky}" />

    <!-- ── Status ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushError"               Color="{StaticResource MillimanErrorDark}" />
    <SolidColorBrush x:Key="BrushWarning"             Color="{StaticResource MillimanWarningDark}" />
    <SolidColorBrush x:Key="BrushSuccess"             Color="{StaticResource MillimanSuccessDark}" />
    <SolidColorBrush x:Key="BrushInfo"                Color="{StaticResource MillimanSky}" />

    <!-- ── Shell chrome ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="BrushStatusBar"           Color="{StaticResource MillimanObsidianDeep}" />
    <SolidColorBrush x:Key="BrushStatusBarText"       Color="{StaticResource MillimanCloud}" />

    
    <!-- ── Caption buttons (title bar chrome) ─────────────────────── -->
    <!-- Hover background for min/max/theme-toggle (slightly lighter than surface) -->
    <SolidColorBrush x:Key="BrushCaptionButtonHover"  Color="{StaticResource MillimanObsidianBorder}" />
    <!-- Close button hover — red per Windows convention                  -->
    <SolidColorBrush x:Key="BrushCaptionCloseHover"   Color="{StaticResource MillimanError}" />

    <!--
    ════════════════════════════════════════════════════════════════════════
    WPF-UI BRUSH KEY OVERRIDES
    Override WPF-UI internal tokens so WPF-UI control templates
    automatically render with Milliman brand colours on dark backgrounds.
    ════════════════════════════════════════════════════════════════════════
    -->

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"          Color="{StaticResource MillimanCloud}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"        Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"         Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"         Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush"          Color="{StaticResource MillimanObsidian}" />

    <!-- Accent text -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"    Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush"  Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush"   Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush"   Color="{StaticResource MillimanSlate}" />

    <!-- Text on accent background (Sky/Ocean fills) -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"  Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource MillimanObsidian}" />

    <!-- Accent fills (buttons, toggles, progress bars) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"        Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"      Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"       Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush"       Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource MillimanSky}" />

    <!-- Control fills (inputs, non-accent interactive surfaces) -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"       Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"     Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"      Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="ControlFillColorQuarternaryBrush"   Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush"      Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush"   Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush"   Color="{StaticResource MillimanObsidian}" />

    <!-- Control strokes (borders) -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"     Color="{StaticResource MillimanObsidianBorder}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"   Color="{StaticResource MillimanSlate}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush"   Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{StaticResource MillimanOcean}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentTertiaryBrush"  Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDisabledBrush"  Color="{StaticResource MillimanSlate}" />

    <!-- Subtle fills (list item hover, row highlights) -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush"    Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush"      Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush"       Color="{StaticResource MillimanObsidianBorder}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush"       Color="Transparent" />

    <!-- Layer fills (cards, panels) -->
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"         Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush"             Color="{StaticResource MillimanObsidianLight}" />

    <!-- Application / window background -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"         Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"  Color="{StaticResource MillimanObsidianDark}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush"      Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"    Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush"     Color="{StaticResource MillimanObsidianLight}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush"  Color="{StaticResource MillimanObsidianLight}" />

    <!-- Card backgrounds -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="{StaticResource MillimanObsidian}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource MillimanObsidianLight}" />

    <!-- Focus -->
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush"         Color="{StaticResource MillimanSky}" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush"         Color="{StaticResource MillimanObsidianDark}" />

    <!-- System status fills -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"        Color="{StaticResource MillimanSuccessDark}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"        Color="{StaticResource MillimanWarningDark}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"       Color="{StaticResource MillimanErrorDark}" />
    <SolidColorBrush x:Key="SystemFillColorNeutralBrush"        Color="{StaticResource MillimanDarkenGray}" />
    <SolidColorBrush x:Key="SystemFillColorSolidNeutralBrush"   Color="{StaticResource MillimanSlate}" />

</ResourceDictionary>
