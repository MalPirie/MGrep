<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  APP-LEVEL CONTROL STYLES                                            ║
    ║                                                                      ║
    ║  All styles reference semantic tokens (BrushXxx) only.              ║
    ║  WPF-UI ControlsDictionary provides the base Fluent 2 templates;    ║
    ║  these styles extend or supplement them for app-specific needs.      ║
    ║                                                                      ║
    ║  RULES:                                                              ║
    ║    ✅  Use {DynamicResource BrushXxx} for all colour references.     ║
    ║    ✅  Use BasedOn to extend WPF-UI styles rather than replace them.  ║
    ║    ❌  No literal colour values.                                      ║
    ║    ❌  No MillimanXxx keys.                                           ║
    ║    ❌  No StaticResource for theme-sensitive brushes.                 ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <!--
        StatusBar — rounded bottom corners + themed background/text.
        CornerRadius matches Windows 11 window chrome rounding.
        Background is set here so it's removed from the view element.
    -->
    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background"  Value="{DynamicResource BrushStatusBar}" />
        <Setter Property="Foreground"  Value="{DynamicResource BrushStatusBarText}" />
        <Setter Property="Padding"     Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type StatusBar}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CornerRadiusStatusBar}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        StatusBarItem — ensure text colour follows the theme.
    -->
    <Style TargetType="{x:Type StatusBarItem}"
           BasedOn="{StaticResource {x:Type StatusBarItem}}">
        <Setter Property="Foreground" Value="{DynamicResource BrushStatusBarText}" />
    </Style>

</ResourceDictionary>
