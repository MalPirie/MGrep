<Window x:Class="MGrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MGrep"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel, IsDesignTimeCreatable=True}"
        d:DesignHeight="450"
        d:DesignWidth="800"
        x:Name="Window"
        Title="MGrep"
        Height="450"
        Width="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBackground}">

    <!-- SystemCommands require explicit CommandBindings with a custom title bar. -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}"    Executed="CloseWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="MinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="MaximizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}"  Executed="RestoreWindow" />
    </Window.CommandBindings>

    <Window.Resources>
        <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <local:FileNameConverter x:Key="FileNameConverter" />
    </Window.Resources>
        
    <DockPanel LastChildFill="True">

        <!-- ── Custom title bar ──────────────────────────────────────────
             WM_NCHITTEST (in code-behind) returns HTCAPTION for the empty
             area here, so native drag/snap/double-click-maximise all work.
             Buttons are detected via VisualTreeHelper and return HTCLIENT.
        ─────────────────────────────────────────────────────────────── -->
        <Grid x:Name="TitleBarGrid"
              DockPanel.Dock="Top"
              Height="32"
              Background="{DynamicResource BrushBackground}">

            <!-- Application icon, far left -->
            <Image Source="/MGrep;component/ApplicationIcon.ico"
                   Width="16" Height="16"
                   Margin="8,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                <!-- Theme toggle — Segoe MDL2: E793 = Brightness (sun), E708 = QuietHours (moon) -->
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle Light / Dark theme">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE793;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Text" Value="&#xE708;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Minimize -->
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE108;" />
                </Button>

                <!-- Maximize / Restore — command and icon switch via WindowState -->
                <Button>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
                            <Setter Property="Command" Value="{x:Static SystemCommands.MaximizeWindowCommand}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=Window, Path=WindowState}"
                                             Value="Maximized">
                                    <Setter Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE739;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=Window, Path=WindowState}"
                                                 Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Close -->
                <Button Style="{StaticResource CaptionCloseButtonStyle}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE106;" />
                </Button>

            </StackPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <Label>Folder</Label>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" 
                              IsEditable="True"
                              ItemsSource="{Binding FolderHistory}"  
                              Text="{Binding Folder}" 
                              ShouldPreserveUserEnteredPrefix="True" />
                    <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFolderCommand}" Margin="4,0,0,0" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Label>Pattern</Label>
                <ComboBox IsEditable="True" 
                          ItemsSource="{Binding PatternHistory}" 
                          Text="{Binding Pattern}" 
                          ShouldPreserveUserEnteredPrefix="True" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <Label>File patterns</Label>
                <ComboBox IsEditable="True" 
                          ItemsSource="{Binding FilePatternsHistory}" 
                          Text="{Binding FilePatterns}" 
                          ShouldPreserveUserEnteredPrefix="True" />
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding MatchCase}" ToolTip="Match case">
                        <TextBlock Text="Aa" FontSize="11" FontWeight="SemiBold" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding MatchWholeWord}" Margin="4,0,0,0" ToolTip="Match whole word">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8C1;" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding UseRegex}" Margin="4,0,0,0" ToolTip="Use regular expression">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE943;" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IncludeSubfolders}"
                                  IsEnabled="{Binding Globbing, Converter={StaticResource InvertedBoolConverter}}"
                                  Margin="12,0,0,0" ToolTip="Include subfolders">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE838;" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding Globbing}"
                                  IsEnabled="{Binding IncludeSubfolders, Converter={StaticResource InvertedBoolConverter}}"
                                  Margin="4,0,0,0" ToolTip="Globbing">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE71C;" />
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IncludeBinaryFiles}" Margin="12,0,0,0" ToolTip="Include binary files">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8A5;" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button IsDefault="True" Width="120" BorderThickness="2">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Search" />
                                <Setter Property="Command" Value="{Binding SearchCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Searching}" Value="True">
                                        <Setter Property="Content" Value="Cancel"/>
                                        <Setter Property="Command" Value="{Binding SearchCancelCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ExportCommand}" Content="Export" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}"
                           Foreground="{DynamicResource BrushStatusBarText}" />
            </StatusBarItem>
        </StatusBar>

        <ContentPresenter Content="{Binding}">
            <ContentPresenter.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <ListView x:Name="List"
                                  ItemsSource="{Binding Matches}"
                                  IsSynchronizedWithCurrentItem="True"
                                  local:DoubleClickBehavior.Command="{Binding OpenCommand}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Line" DisplayMemberBinding="{Binding LineNumber}" />
                                    <GridViewColumn Header="Text" DisplayMemberBinding="{Binding Text}" />
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"
                                       BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource FileNameConverter}">
                                                        <Binding Path="FileName" />
                                                        <Binding Path="DataContext.Folder" Source="{x:Reference Window}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock x:Name="EmptyList" Text="No matches found" Visibility="Collapsed"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Matches.Count}" Value="0">
                            <Setter TargetName="List" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="EmptyList" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ContentPresenter.ContentTemplate>
        </ContentPresenter>

    </DockPanel>
</Window>
